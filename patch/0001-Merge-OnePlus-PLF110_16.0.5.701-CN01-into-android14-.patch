+static inline bool cont_pte_readonly(struct vm_fault *vmf)
+{
+	int i, nr = 0;
+	unsigned long haddr = vmf->address & HPAGE_CONT_PTE_MASK;
+	pte_t *ptep = vmf->pte - (vmf->address - haddr)/PAGE_SIZE;
+
+	/* someone else has changed ptes to non-cont */
+	if (!pte_cont(*ptep))
+		return false;
+
+	for (i = 0; i < HPAGE_CONT_PTE_NR; i++, ptep++) {
+		if (pte_write(*ptep))
+			nr++;
+
+#if CONFIG_CHP_ABNORMAL_PTES_DEBUG
+		if (!pte_cont(*ptep)) {
+			check_cont_pte_trans_huge(ptep, CORRUPT_CONT_PTE_REASON_PTE_READONLY);
+		}
+#endif
+	}
+
+	if (nr != HPAGE_CONT_PTE_NR && nr != 0) {
+		ptep -= HPAGE_CONT_PTE_NR;
+		printk(KERN_ERR "@@@Fixme- partially writable in hugepage: %s current:%s-%d nr:%d fault addr:%lx vma start:%lx end:%lx "
+				"ptep:%lx ptes:%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx-%llx \n",
+				__func__, current->comm, current->pid, nr, vmf->address, vmf->vma->vm_start, vmf->vma->vm_end,
+				(unsigned long)ptep, pte_val(*(ptep + 0)), pte_val(*(ptep + 1)), pte_val(*(ptep + 2)), pte_val(*(ptep + 3)),
+				pte_val(*(ptep + 4)), pte_val(*(ptep + 5)), pte_val(*(ptep + 6)), pte_val(*(ptep + 7)),
+				pte_val(*(ptep + 8)), pte_val(*(ptep + 9)), pte_val(*(ptep + 10)), pte_val(*(ptep + 11)),
+				pte_val(*(ptep + 12)), pte_val(*(ptep + 13)), pte_val(*(ptep + 14)), pte_val(*(ptep + 15)));
+#if CONFIG_CHP_ABNORMAL_PTES_DEBUG
+		commit_chp_abnormal_ptes_record(CORRUPT_CONT_PTE_REASON_PTE_PRERM);
+#endif
+		CHP_BUG_ON(1);
+	}
+
+	return !nr;
+}
