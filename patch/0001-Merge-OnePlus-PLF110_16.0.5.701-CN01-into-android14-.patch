+#define cont_ptep_clear_flush_young_notify(__vma, __address, __ptep)	\
+({									\
+	int __young = 0;						\
+	unsigned long i;						\
+	struct vm_area_struct *___vma = __vma;				\
+	unsigned long ___address = __address & HPAGE_CONT_PTE_MASK;	\
