+            U32 const curr = (U32)(ip-base);
+            size_t const hL = ZSTD_hashPtr(ip, hBitsL, 8);
+            size_t const hS = ZSTD_hashPtr(ip, hBitsS, mls);
+            const size_t mLength = ZSTD_count(ip+4, match+4, iend)+4;
