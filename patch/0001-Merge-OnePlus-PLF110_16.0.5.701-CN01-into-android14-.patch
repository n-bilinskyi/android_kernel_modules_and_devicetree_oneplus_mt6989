diff --git a/BUILD.bazel b/BUILD.bazel
index 9240837a9a8e..e2aa4ecfeeda 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -881,6 +881,30 @@ ddk_headers(
     visibility = ["//visibility:public"],
 )
 
+# oplus modules depend on ack need headers add here
+# globs() for all architectures
+filegroup(
+    name = "all_headers_allowlist_common_globs_oplus",
+    srcs = glob([
+        "kernel/**/*.h",
+        "fs/**/*.h",
+        "**/**/*.h",
+        "mm/*.h",
+    ]),
+    visibility = ["//visibility:private"],
+)
+# oplus modules depend on ack need directory add here
+linux_includes_oplus = [
+    "include",
+    "include/linux",
+    "include/trace",
+    "kernel",
+    "fs/proc",
+    "fs",
+    "mm",
+    ".",
+]
+
 # Implementation details for DDK headers. The targets below cannot be directly
 # depended on by DDK modules.
 
@@ -891,6 +915,7 @@ ddk_headers(
     hdrs = [
         ":all_headers_allowlist_aarch64_globs",
         ":all_headers_allowlist_common_globs",
+        ":all_headers_allowlist_common_globs_oplus",
     ],
     # The list of include directories where source files can #include headers
     # from. In other words, these are the `-I` option to the C compiler.
@@ -900,7 +925,7 @@ ddk_headers(
         "arch/arm64/include/uapi",
         "include",
         "include/uapi",
-    ],
+    ] + linux_includes_oplus,
     visibility = ["//visibility:private"],
 )
 
@@ -1016,3 +1041,4 @@ ddk_headers(
     includes = [],
     visibility = ["//visibility:private"],
 )
+
