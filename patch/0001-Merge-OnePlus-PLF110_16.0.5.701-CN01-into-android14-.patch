+#ifdef CONFIG_BLOCKIO_UX_OPT
+extern __u32 get_block_ux_softirqs(void);
+extern void clear_block_ux_softirqs(void);
+unsigned long counter, total_us, max_us, min_us, aver_us, restart_time;
+#endif
